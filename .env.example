POSTGRES_PASSWORD=local-only
SECRET_KEY=replace-with-a-random-local-secret
DEBUG=1
USE_POSTGRES=1
CELERY_BROKER_URL=redis://redis:6379/0
RUNNER_TOKEN=replace-with-a-random-local-worker-secret
# Change these if another local project uses the default ports.
TRELLIS_FRONTEND_PORT=5173
TRELLIS_BACKEND_PORT=8000

# Optional Canvas publishing. Keep real credentials in .env only.
CANVAS_BASE_URL=
CANVAS_API_TOKEN=
TRELLIS_PUBLIC_URL=http://localhost:5173
