{
  "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "subscriptionId": {
      "type": "String"
    },
    "name": {
      "type": "String"
    },
    "location": {
      "type": "String"
    },
    "environmentId": {
      "type": "String"
    },
    "containers": {
      "type": "Array"
    },
    "secrets": {
      "defaultValue": {
        "arrayValue": []
      },
      "type": "SecureObject"
    },
    "registries": {
      "type": "Array"
    },
    "environmentName": {
      "type": "String"
    },
    "workspaceId": {
      "type": "String"
    }
  },
  "resources": [
    {
      "type": "Microsoft.App/containerapps",
      "apiVersion": "2026-03-02-preview",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "tags": {
        "Owner": "bkarkada3",
        "Project": "CS1301",
        "Environment": "POC"
      },
      "kind": "containerapps",
      "properties": {
        "environmentId": "[parameters('environmentId')]",
        "configuration": {
          "secrets": "[parameters('secrets').arrayValue]",
          "registries": "[parameters('registries')]",
          "activeRevisionsMode": "Single"
        },
        "template": {
          "containers": "[parameters('containers')]",
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        },
        "workloadProfileName": "Consumption"
      }
    }
  ]
}
